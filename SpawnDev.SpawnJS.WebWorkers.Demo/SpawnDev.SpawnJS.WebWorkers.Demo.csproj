<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

	<!-- SpawnDev.SpawnJS.WebWorkers build integration.
	     Debug consumes the library via ProjectReference (dev inner loop). A ProjectReference does NOT
	     auto-import the package's build/ props+targets, and the classic/module bundle build is required
	     even in dev (workers load main.classic.js), so import them explicitly for Debug. Release consumes
	     the published package, whose build/ props+targets NuGet auto-imports. -->
	<Import Project="..\SpawnDev.SpawnJS.WebWorkers\build\SpawnDev.SpawnJS.WebWorkers.props"
			Condition=" '$(Configuration)' == 'Debug' " />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<CompressionEnabled>false</CompressionEnabled>
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
	</PropertyGroup>

	<ItemGroup Condition=" '$(Configuration)' == 'Debug' ">
		<ProjectReference Include="..\SpawnDev.SpawnJS.WebWorkers\SpawnDev.SpawnJS.WebWorkers.csproj" />
	</ItemGroup>

	<ItemGroup Condition=" '$(Configuration)' == 'Release' ">
		<PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="1.0.2" />
	</ItemGroup>

	<ItemGroup>
		<StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
	</ItemGroup>

	<Import Project="..\SpawnDev.SpawnJS.WebWorkers\build\SpawnDev.SpawnJS.WebWorkers.targets"
			Condition=" '$(Configuration)' == 'Debug' " />
</Project>
