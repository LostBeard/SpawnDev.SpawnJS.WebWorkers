<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>2.2.1</Version>
		<PackageReleaseNotes>v2.2.1 - Trim safe: IsTrimmable, trim warnings are build errors, and the test suite passes on a fully trimmed publish (TrimMode=full). Fix: an exception thrown synchronously by a worker method arrived as a plain Exception (wrapped in TargetInvocationException) instead of its own type. await (dynamic) removed (Microsoft.CSharp runtime binder). Service-type entry points carry DynamicallyAccessedMembers; GetService/GetKeyedService are marked RequiresDynamicCode (DispatchProxy: works on browser Mono, not NativeAOT).</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.SpawnJS.WebWorkers</Title>
		<Authors>LostBeard</Authors>
		<Description>Call Services and static methods in separate threads with WebWorkers and SharedWebWorkers. Run .Net WASM in the ServiceWorker.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.SpawnJS.WebWorkers</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.SpawnJS.WebWorkers.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;BlazorWebAssembly;DotNetWebAssembly;MultiThreading;ServiceWorker;WebWorker</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<!-- Trim safe, enforced: the trim analyzer runs on every build and any trim (IL2xxx) warning fails it.
		     NOT IsAotCompatible: the interface proxy (GetService/GetKeyedService, DispatchProxy) and two runtime generic
		     closures need dynamic code. Browser .NET runs them (Mono interpreter, and Mono AOT via its interpreter
		     fallback); NativeAOT cannot. The AOT analyzer stays on so those IL3050 sites remain visible. -->
		<IsTrimmable>true</IsTrimmable>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2060;IL2062;IL2065;IL2067;IL2069;IL2070;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2080;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2106;IL2111;IL2112;IL2113;IL2114</WarningsAsErrors>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Images\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- Classic/module bundle build integration (mirrors SpawnDev.BlazorJS.WebWorkers).
	     build\      -> MSBuild props/targets auto-imported into the consumer's build.
	     buildcontent\ -> Rollup entry (loader.js), self-contained Rollup (rollup.bundled.mjs), event-holder.
	     tasks\      -> compiled MSBuild task assembly (from SpawnDev.SpawnJS.WebWorkers.Build).
	     These folders are not part of the library compile; they are packed into the NuGet package. -->
	<ItemGroup>
		<Compile Remove="build\**" />
		<Content Remove="build\**" />
		<EmbeddedResource Remove="build\**" />
		<None Remove="build\**" />

		<Compile Remove="buildcontent\**" />
		<Content Remove="buildcontent\**" />
		<EmbeddedResource Remove="buildcontent\**" />
		<None Remove="buildcontent\**" />

		<Compile Remove="tasks\**" />
		<Content Remove="tasks\**" />
		<EmbeddedResource Remove="tasks\**" />
		<None Remove="tasks\**" />

		<Content Include="build\**">
			<Pack>true</Pack>
			<PackagePath>build</PackagePath>
		</Content>
		<Content Include="buildcontent\**">
			<Pack>true</Pack>
			<PackagePath>buildcontent</PackagePath>
		</Content>
		<Content Include="tasks\**">
			<Pack>true</Pack>
			<PackagePath>tasks</PackagePath>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.0" />
	</ItemGroup>
	
	<PropertyGroup>
		<StaticWebAssetBasePath Condition="$(StaticWebAssetBasePath) == ''">/</StaticWebAssetBasePath>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

</Project>
