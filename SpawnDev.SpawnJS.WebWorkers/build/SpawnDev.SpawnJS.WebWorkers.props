<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- Required so this library's wwwroot is available in the consumer's output. -->
	<Import Project="Microsoft.AspNetCore.StaticWebAssets.props" Condition="Exists('$(MSBuildThisFileDirectory).\Microsoft.AspNetCore.StaticWebAssets.props')" />

	<PropertyGroup>
		<!-- SpawnJSWebWorkersBlazor, SpawnJSWebWorkersClassicBundle and WasmBundlerFriendlyBootConfig are DERIVED
		     from each other and from the SDK, so their defaults live in SpawnDev.SpawnJS.WebWorkers.targets, NOT here.
		     A package .props is imported BEFORE the consuming project's body: a default computed here reads the
		     consumer's own setting as empty, so an explicit <SpawnJSWebWorkersBlazor>false</...> in the csproj could
		     never turn the classic bundle back on (2.1.19 regression: RazorRenderer apps built with the Blazor SDK -
		     e.g. browser extensions - lost main.classic.js / main.module.js). -->

		<!-- Publish-only, opt-in: rename the underscore-prefixed output folders so a published app can run
		     where paths starting with '_' are illegal (browser extensions). Empty = no rename (default).
		     Set to a folder name (must NOT start with '_' or '.'), e.g.
		       <SpawnJSWebWorkersFrameworkFolderName>framework</SpawnJSWebWorkersFrameworkFolderName>
		       <SpawnJSWebWorkersContentFolderName>content</SpawnJSWebWorkersContentFolderName>  (only if _content is used)
		     Renames the folder AND rewrites references in the published js/html/json/css (incl. main.classic.js).
		     Sharp tool: an app that builds a "_framework"/"_content" path at runtime from a variable will break. -->
		<SpawnJSWebWorkersFrameworkFolderName Condition="'$(SpawnJSWebWorkersFrameworkFolderName)' == ''"></SpawnJSWebWorkersFrameworkFolderName>
		<SpawnJSWebWorkersContentFolderName Condition="'$(SpawnJSWebWorkersContentFolderName)' == ''"></SpawnJSWebWorkersContentFolderName>

		<_SpawnJSWebWorkersBuildTasksAssembly Condition="'$(_SpawnJSWebWorkersBuildTasksAssembly)' == ''">$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\SpawnDev.SpawnJS.WebWorkers.Build.dll</_SpawnJSWebWorkersBuildTasksAssembly>
		<_SpawnJSWebWorkersBuildContentDir Condition="'$(_SpawnJSWebWorkersBuildContentDir)' == ''">$(MSBuildThisFileDirectory)..\buildcontent</_SpawnJSWebWorkersBuildContentDir>
	</PropertyGroup>

	<!-- TaskHostFactory runs each task in a short-lived, out-of-process MSBuild task host that exits when
	     the build finishes, so the persistent VS/MSBuild build node never keeps a long-lived lock on the
	     task DLL. Without this, the node loads tasks\...\SpawnDev.SpawnJS.WebWorkers.Build.dll and holds it
	     open (node reuse), so the NEXT build of the inner .Build project cannot overwrite that copy and
	     fails with MSB3021 "being used by another process". All task inputs/outputs here are string / bool /
	     ITaskItem[], which MSBuild marshals across the task-host process boundary, so out-of-proc is safe. -->
	<UsingTask TaskName="SpawnDev.SpawnJS.WebWorkers.Build.Tasks.SpawnJSWebWorkersBundle" AssemblyFile="$(_SpawnJSWebWorkersBuildTasksAssembly)" TaskFactory="TaskHostFactory" />
	<UsingTask TaskName="SpawnDev.SpawnJS.WebWorkers.Build.Tasks.SpawnJSWebWorkersRenameFolders" AssemblyFile="$(_SpawnJSWebWorkersBuildTasksAssembly)" TaskFactory="TaskHostFactory" />

</Project>
