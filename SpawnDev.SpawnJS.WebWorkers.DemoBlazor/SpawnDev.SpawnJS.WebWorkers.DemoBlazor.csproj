<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<!-- ProjectReference does not auto-import NuGet build/ props+targets; Blazor worker mode +
	     attribute stamping require both (props sets SpawnJSWebWorkersBlazor from the Blazor SDK). -->
	<Import Project="..\SpawnDev.SpawnJS.WebWorkers\build\SpawnDev.SpawnJS.WebWorkers.props" Condition=" '$(Configuration)' == 'Debug' " />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<CompressionEnabled>false</CompressionEnabled>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
		<PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="2.1.18" />
	</ItemGroup>

	<ItemGroup Condition=" '$(Configuration)' == 'Debug' ">
		<ProjectReference Include="..\SpawnDev.SpawnJS.WebWorkers\SpawnDev.SpawnJS.WebWorkers.csproj" />
	</ItemGroup>

	<ItemGroup Condition=" '$(Configuration)' == 'Release' ">
		<PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="2.1.19" />
	</ItemGroup>

	<Import Project="..\SpawnDev.SpawnJS.WebWorkers\build\SpawnDev.SpawnJS.WebWorkers.targets" Condition=" '$(Configuration)' == 'Debug' " />

</Project>
